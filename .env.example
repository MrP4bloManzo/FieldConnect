DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldconnect
DATABASE_SCHEMA=fieldconnect
DATABASE_SSL=false
# Opcional: certificado CA PEM del proveedor, con saltos de línea como \n.
DATABASE_CA_CERT=
# Genera un secreto con: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@fieldconnect.local
SEED_ADMIN_PASSWORD=ChangeMe_12345!
# Opcional: segunda cuenta de acceso. Usa contraseñas distintas de 12+ caracteres.
SEED_DIRECTOR_NAME=Directivo
SEED_DIRECTOR_EMAIL=directivo@fieldconnect.local
SEED_DIRECTOR_PASSWORD=
# Supabase: copia la conexión Session pooler del panel, activa DATABASE_SSL=true.
